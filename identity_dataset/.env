# Identity dataset trainer configuration.
# This file is separate from repo root .env and is used by:
#   python -m identity_dataset.train_image_conditioned_loop

# -----------------------------------------------------------------------------
# Required: dataset root
# -----------------------------------------------------------------------------
# Source dataset root (required at least once). Folder layout:
#   <root>/<page>/<person_folder>/*.jpg|png|webp|...
#   or flattened: <root>/<person_folder>/*.jpg|png|webp|...
IDENTITY_TRAIN_DATA_ROOT=D:\VirtualEnvPy\tradebot\UltimateTradeBot\Miscellaneous\FsiBlog\downloads\sweet_photos
ZIMAGE_IDENTITY_DATA_ROOT=

# -----------------------------------------------------------------------------
# Model + tokenizer + scheduler (run with real Z-Image model)
# -----------------------------------------------------------------------------
IDENTITY_TRAIN_MODEL_PATH=./models/Z-Image-Turbo
ZIMAGE_MODEL_PATH=
IDENTITY_TRAIN_DTYPE=bfloat16
IDENTITY_TRAIN_COMPILE_MODEL=0
IDENTITY_TRAIN_MAX_SEQUENCE_LENGTH=256
IDENTITY_TRAIN_SCHEDULER_STEPS=1000

# -----------------------------------------------------------------------------
# Pair generation / data sampling
# -----------------------------------------------------------------------------
IDENTITY_TRAIN_SOURCE_COUNTS=1
IDENTITY_TRAIN_SOURCE_COUNTS_ONE_WEIGHT=1.0
IDENTITY_TRAIN_SOURCE_COUNTS_TWO_WEIGHT=1.0
IDENTITY_TRAIN_IMAGE_SIZE=128
IDENTITY_TRAIN_MAX_PAIRS_PER_PERSON=1
# Very quick smoke-test cap for end-to-end verification. Set blank to disable.
IDENTITY_TRAIN_MAX_TOTAL_PAIRS=600

# -----------------------------------------------------------------------------
# Training schedule + optimization (throughput-first defaults)
# -----------------------------------------------------------------------------
IDENTITY_TRAIN_SEED=42
IDENTITY_TRAIN_BATCH_SIZE=1
IDENTITY_TRAIN_EPOCHS=10
IDENTITY_TRAIN_LR=1e-4
IDENTITY_TRAIN_OPTIMIZER=sgd
IDENTITY_TRAIN_OPTIMIZER_MOMENTUM=0.0
# For smoke tests, optimize only a tiny module to keep optimizer state small.
IDENTITY_TRAIN_TRAINABLE_PREFIXES=transformer.all_final_layer
IDENTITY_TRAIN_NONFINITE_LOSS_MODE=replace
IDENTITY_TRAIN_LOSS_FLOAT32=1
IDENTITY_TRAIN_GRAD_CLIP_NORM=1.0
IDENTITY_TRAIN_CHECKPOINT_SCOPE=trainable
IDENTITY_TRAIN_SAVE_FINAL_CHECKPOINT=1
IDENTITY_TRAIN_SAVE_OPTIMIZER_STATE=0
IDENTITY_TRAIN_SAVE_CHECKPOINT_CPU=1
IDENTITY_TRAIN_MIN_IDENTITIES_PER_BATCH=2
IDENTITY_TRAIN_MODE=mixed
IDENTITY_TRAIN_DROP_LAST=0
IDENTITY_TRAIN_OUTPUT_DIR=identity_dataset/checkpoints
IDENTITY_TRAIN_CHECKPOINT_EVERY=100
# Small number for fast verification across random identities per epoch.
IDENTITY_TRAIN_MAX_PERSONS_PER_EPOCH=50
# Person-aware validation split (set ratio to 0 or disable to keep train-only).
IDENTITY_TRAIN_VALIDATION_ENABLED=1
IDENTITY_TRAIN_VALIDATION_RATIO=0.08
IDENTITY_TRAIN_VALIDATE_EVERY=1
IDENTITY_TRAIN_VALIDATION_PERSONS_PER_EPOCH=
IDENTITY_TRAIN_DEVICE=cuda

# -----------------------------------------------------------------------------
# DataLoader performance / throughput
# -----------------------------------------------------------------------------
IDENTITY_TRAIN_NUM_WORKERS=0
IDENTITY_TRAIN_PREFETCH_FACTOR=2
IDENTITY_TRAIN_PIN_MEMORY=1
IDENTITY_TRAIN_PERSISTENT_WORKERS=1
IDENTITY_TRAIN_NON_BLOCKING=1
IDENTITY_TRAIN_WARMUP_STEPS=0

# -----------------------------------------------------------------------------
# How the trainer works
# -----------------------------------------------------------------------------
# - Prompt text is derived from person folder name:
#   ...\page001\Swimming pool in terrace with rain water for topless bath
#   -> "Swimming pool in terrace with rain water for topless bath"
# - Per-epoch person sampling:
#   - empty/0 => use all persons every epoch (full dataset per epoch)
#   - positive integer => sample that many random identities per epoch
#
# You can keep this file version-controlled by:
# - committing safe placeholder values only, and
# - overriding with machine-local absolute paths locally when needed.
